# Deaf/HoH Accessibility Assistant — environment variables
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — never commit secrets.

# -- LLM provider (Groq hosts open-weight models with low latency / free tier) --
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY= 

# -- LLM model selection --
ACCESSIBILITY_LLM_MODEL=openai/gpt-oss-20b

# -- Whisper STT model size --
# Options: tiny | base | small | medium | large
ACCESSIBILITY_WHISPER_SIZE=small

# -- YamNet model (optional override) --
# YAMNET_MODEL_PATH=/path/to/yamnet.tflite

# -- BLIP model selection --
ACCESSIBILITY_BLIP_MODEL=Salesforce/blip-image-captioning-base

# -- Server port --
ACCESSIBILITY_PORT=5051

# -- SQLite database path (anonymised soundscape diary) --
ACCESSIBILITY_DB_PATH=./data/diary.db

# -- ESC-50 dataset path (auto-populated by scripts/download_esc50.py) --
ESC50_PATH=./data/ESC-50

# -- Latency budget (ms) — events slower than this are flagged in logs --
LATENCY_BUDGET_MS=500

# -- Optional: HuggingFace token for gated models --
HF_TOKEN=

# -- Optional: Pyannote token for speaker diarization --
# Get one from https://huggingface.co/pyannote/speaker-diarization-3.1
PYANNOTE_TOKEN=
